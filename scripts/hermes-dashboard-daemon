#!/usr/bin/env python3
import socket
import subprocess
import sys
import time

def is_running(port=9119):
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(0.3)
            return s.connect_ex(("127.0.0.1", port)) == 0
    except Exception:
        return False

def main():
    if not is_running(9119):
        subprocess.Popen(
            ["/root/.local/bin/hermes", "dashboard", "--skip-build", "--no-open", "--port", "9119"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )
        # Wait up to 3 seconds for port to open
        for _ in range(30):
            if is_running(9119):
                break
            time.sleep(0.1)

if __name__ == "__main__":
    main()
