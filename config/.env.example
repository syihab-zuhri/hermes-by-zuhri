# Environment variables template for hermes-by-zuhri
# Rename to .env in ~/.hermes/.env or source into your environment

# Primary Provider (OpenAI / OpenRouter / Custom / 9router)
OPENAI_API_KEY=your_openai_or_custom_key_here

# Anthropic (Optional)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google Gemini (Optional)
GEMINI_API_KEY=your_gemini_key_here

# Custom Gateway / Local Router (e.g. 9router / LiteLLM)
# CUSTOM_BASE_URL=http://127.0.0.1:20129/v1

# Cloudflare MCP / API (Optional)
# CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
